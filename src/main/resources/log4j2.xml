<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j 2 replacement for the old log4j 1.x log4j.properties.
  Original behaviour: DEBUG root level, daily-rolling file "extractor.log"
  with pattern "%d [%t] %-5p: %m%n" and append=true.
-->
<Configuration status="WARN">
  <Appenders>
    <RollingFile name="A1"
                 fileName="extractor.log"
                 filePattern="extractor.log.%d{yyyy-MM-dd}"
                 append="true">
      <PatternLayout pattern="%d [%t] %-5p: %m%n"/>
      <Policies>
        <TimeBasedTriggeringPolicy/>
      </Policies>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Root level="DEBUG">
      <AppenderRef ref="A1"/>
    </Root>
  </Loggers>
</Configuration>
